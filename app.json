{
  "expo": {
    "name": "KKP SuperApps",
    "slug": "KKP SuperApps",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/logokkp.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.id.telkom.ndeossit"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "co.id.telkom.ndeossit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "67a24de0-ba05-4212-b877-20e678c71fec"
      }
    },
    "plugins": [
      [
        "expo-document-picker",
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access camera."
        }
      ]
    ]
  }
}
