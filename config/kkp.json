{
  "scheme": "kkp",
  "name": "SuperApps KKP",
  "slug": "kkpsuperapps",
  "version": "0.2.1",
  "orientation": "portrait",
  "icon": "./assets/superApp/kkp-icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "image": "./assets/superApp/splashkkp.png",
    "resizeMode": "cover",
    "backgroundColor": "#ffffff"
  },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": ["**/*"],
  "ios": {
    "buildNumber": "7.3.1",
    "supportsTablet": true,
    "bundleIdentifier": "go.id.kkp.portal",
    "infoPlist": {
      "NSPhotoLibraryUsageDescription": "Our app needs access to your photo library",
      "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera"
    }
  },
  "android": {
    "versionCode": 738,
    "enableHermes": true,
    "notification": {
      "icon": "./assets/ic_stat_onesignal_default.png",
      "color": "#323247"
    },
    "permissions": [
      "WRITE_EXTERNAL_STORAGE",
      "READ_EXTERNAL_STORAGE",
      "CAMERA",
      "INTERNET",
      "ACCESS_FINE_LOCATION",
      "ACCESS_COARSE_LOCATION"
    ],
    "adaptiveIcon": {
      "foregroundImage": "./assets/superApp/kkp-icon.png",
      "backgroundColor": "#FFFFFF"
    },
    "package": "go.id.kkp.portal",
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "https",
            "host": "portal.kkp.go.id",
            "pathPrefix": "/apps/KnowledgeManagement/detail/:id/:id_user"
          }
        ],
        "category": ["BROWSABLE", "DEFAULT"]
      }
    ]
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "@config-plugins/react-native-blob-util",
    "@config-plugins/react-native-pdf",
    [
      "expo-build-properties",
      {
        "android": {
          "compileSdkVersion": 34,
          "targetSdkVersion": 34,
          "buildToolsVersion": "34.0.0",
          "useLegacyPackaging": true,
          "enableProguardInReleaseBuilds": true,
          "enableShrinkResourcesInReleaseBuilds": true,
          "minifyEnabled": true,
          "shrinkResources": true,
          "splits": {
            "abi": true
          },
          "jsEngine": "hermes"
        },
        "ios": {
          "deploymentTarget": "13.4"
        }
      }
    ],
    [
      "@sentry/react-native/expo",
      {
        "url": "https://newsentry.armsolusi.com/",
        "note": "a29e24a0762d4f90963114106a9b128289743c9272284efa895368d2f8cd9772",
        "project": "kkp-mobile-prod",
        "organization": "sentry"
      }
    ],
    [
      "expo-barcode-scanner",
      {
        "cameraPermission": "Allow $(PRODUCT_NAME) to access camera."
      }
    ],
    [
      "onesignal-expo-plugin",
      {
        "mode": "development",
        "smallIcons": ["./assets/ic_stat_onesignal_default.png"],
        "smallIconAccentColor": "#323247"
      }
    ]
  ],
  "extra": {
